# Neuhom Lighting Designer — environment variables
# Nothing here is required yet: without these the app runs in labelled demo mode.
# Never commit real values. Keys are used on the server only.

# AI room-photo analysis (Claude, Anthropic API)
ANTHROPIC_API_KEY=

# Concept visualisation (image generation provider, to be chosen)
IMAGE_PROVIDER=
IMAGE_PROVIDER_API_KEY=

# Database and file storage (when moving from browser storage to the cloud)
DATABASE_URL=postgresql://user:password@localhost:5432/neuhom
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
